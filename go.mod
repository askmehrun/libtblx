// libtblx is the reference implementation of the TBLX binary columnar
// file format: a dependency-free Go library (this module's root
// package), a C shared-library bridge (./clib) and a Python binding
// (./python) built on top of it.
//
//	import tblx "github.com/askmehrun/libtblx"
module github.com/askmehrun/libtblx

go 1.26
